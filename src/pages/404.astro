---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <Hero compact>
    <h1>Page not found</h1>
    <p class="intro">This page doesn't exist, or it has moved.</p>
  </Hero>

  <main id="main" class="wrap section">
    <ul class="links">
      <li><a class="pill" href="/">Home</a></li>
      <li><a class="pill" href="/projects/">All work</a></li>
    </ul>
  </main>

  <SiteFooter />
</Layout>

<style>
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .intro {
    margin-top: 12px;
    color: var(--on-dark-muted);
    font-size: 1.125rem;
  }

  .section {
    padding-block: 64px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
