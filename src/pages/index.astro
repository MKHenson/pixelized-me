---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import me from '../assets/me.jpg';
import Hero from '../components/Hero.astro';
import HeroScene from '../components/HeroScene.astro';
import DecoRule from '../components/DecoRule.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getProjects, statusLabel, yearsOf } from '../lib/projects';
import { diamondLattice, fanScales } from '../lib/patterns';
import { technologyGroups } from '../data/technologies';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const texture = diamondLattice('rgba(201,162,74,0.16)', 40);
const tealScales = fanScales('#10454a', 'rgba(228,199,126,0.22)', 40);
---

<Layout title="pixelized.me">
  <Hero current="home">
    <p class="label kicker">Mathew Henson</p>
    <h1>Code, polygons &amp; playable worlds.</h1>
    <p class="intro">Engineer building immersive & engaging applications. Check out my latest work below or browse my portfolio.</p>
    <HeroScene slot="art" class="art" />
  </Hero>

  <main id="main" style={`--texture:${texture}`}>
    <section class="wrap section" aria-labelledby="featured-heading">
      <div class="section-head">
        <h2 id="featured-heading">Featured</h2>
        <a class="pill" href="/projects/">All {projects.length} projects →</a>
      </div>
      <ul class="featured">
        {
          featured.map((project) => (
            <li class="feature">
              <div class="feature-media stepped">
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  widths={[640, 960, 1280, 1680]}
                  sizes="(min-width: 1184px) 680px, (min-width: 900px) 60vw, 100vw"
                />
              </div>
              <div class="feature-body">
                <p class="label meta">
                  {statusLabel(project)} · {yearsOf(project)}
                </p>
                <h3>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                </h3>
                <p class="summary">{project.data.summary}</p>
                <span class="label more" aria-hidden="true">
                  Read more →
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="wrap"><DecoRule /></div>

    <section id="about" class="wrap section about" aria-labelledby="about-heading">
      <div class="portrait">
        <Image src={me} alt="Mathew Henson" width={300} height={380} densities={[1, 2]} />
      </div>
      <div class="about-body">
        <p class="label kicker-dark">About</p>
        <h2 id="about-heading">Hi, I'm Mat.</h2>
        <p>Welcome to my digital home 👋 I love building immersive, engaging applications. I've worked in a wide range of industries, including gaming, finance, cyber security and HR. Outside work I play music, go to the gym, make videos of my projects and love spending time with creative people. I'm always coming up with new ventures and dreams to chase. Get in touch if you want to build something together 😊</p>
      </div>
    </section>

    <section class="tech" aria-labelledby="tech-heading" style={`--scales:${tealScales}`}>
      <div class="wrap">
        <div class="section-head">
          <h2 id="tech-heading">Technologies</h2>
        </div>
        <ul class="tech-grid">
          {
            technologyGroups.map((group) => (
              <li class="tech-group stepped">
                <h3 class="label">{group.title}</h3>
                <ul class="tech-items">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .kicker {
    margin-bottom: 20px;
    color: var(--gold);
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1;
  }

  .intro {
    max-width: 520px;
    margin-top: 20px;
    color: var(--on-dark-muted);
    font-size: 1.125rem;
  }

  :global(.hero .art) {
    flex: 0 1 auto;
    width: clamp(300px, 46vw, 560px);
    margin-bottom: 100px;
  }

  @media (max-width: 760px) {
    :global(.hero .art) {
      position: absolute;
      right: -60px;
      bottom: 0;
      width: 320px;
      opacity: 0.35;
    }
  }

  main {
    background:
      linear-gradient(90deg, transparent, var(--paper) 18%, var(--paper) 82%, transparent),
      var(--texture) var(--paper);
  }

  .section {
    padding-block: 64px;
  }

  h2 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .section-head .pill:hover {
    background: var(--navy);
    color: var(--on-dark);
  }

  .featured {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    background: var(--navy);
    color: var(--on-dark);
    border: 2px solid var(--gold);
    box-shadow: 0 0 0 5px var(--paper), 0 0 0 6px var(--gold);
  }

  .feature-media {
    --step: 0px;
    overflow: hidden;
    border-right: 2px solid var(--gold);
  }

  .feature-media :global(img) {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 40px 36px;
  }

  .meta,
  .more {
    color: var(--gold);
  }

  .feature h3 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 400;
  }

  .feature h3 a {
    text-decoration: none;
  }

  .feature h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--on-dark-muted);
    font-size: 1.0625rem;
  }

  .more {
    margin-top: auto;
    padding-top: 16px;
  }

  .feature:has(a:hover) .more {
    color: var(--gold-light);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-media {
      border-right: 0;
      border-bottom: 2px solid var(--gold);
    }

    .feature-media :global(img) {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }

  /* An arched portrait, the shape of a deco doorway. */
  .portrait {
    flex: 0 0 auto;
    width: clamp(220px, 28vw, 300px);
    padding: 8px;
    border: 2px solid var(--gold);
    border-radius: 999px 999px 0 0;
    background: var(--navy);
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 300 / 380;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
  }

  .about-body {
    flex: 1 1 420px;
    max-width: var(--prose-width);
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink-muted);
    font-size: 1.125rem;
  }

  .kicker-dark {
    color: var(--coral);
  }

  .about-body h2 {
    color: var(--ink);
  }

  .tech {
    padding-block: 64px 72px;
    background-color: var(--teal);
    background-image:
      linear-gradient(180deg, rgb(16 69 74 / 0.6), rgb(16 69 74 / 0.95)),
      var(--scales);
    color: var(--on-dark);
    border-top: 2px solid var(--gold);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-group {
    --step: 8px;
    padding: 28px 28px 32px;
    background: var(--navy);
  }

  .tech-group h3 {
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgb(201 162 74 / 0.5);
    color: var(--gold);
  }

  .tech-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .tech-items li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tech-items li::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--coral);
    transform: rotate(45deg);
  }
</style>
