---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YouTube from '../../components/YouTube.astro';
import GoogleSlides from '../../components/GoogleSlides.astro';
import Exhibit from '../../components/Exhibit.astro';
import DecoMotif from '../../components/DecoMotif.astro';
import DecoRule from '../../components/DecoRule.astro';
import { HEADER_ART, getProjects, statusLabel, yearsOf, type Project } from '../../lib/projects';
import { diamondLattice } from '../../lib/patterns';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, newer: projects[i - 1], older: projects[i + 1], art: HEADER_ART[i % HEADER_ART.length] },
  }));
}

interface Props {
  project: Project;
  newer?: Project;
  older?: Project;
  art: (typeof HEADER_ART)[number];
}

const { project, newer, older, art } = Astro.props;
const { Content } = await render(project);
const { title, summary, cover, coverAlt, gallery, links, tags, studio } = project.data;

// Show the cover only when the write-up does not already include it.
const coverStem = cover.src.split('?')[0].split('/').pop()!.split('.')[0];
const showCover = !project.body?.includes(`./${coverStem}.`);
const texture = diamondLattice('rgba(201,162,74,0.16)', 40);
---

<Layout title={title} description={summary}>
  <Hero current="projects" compact>
    <p class="crumb"><a href="/projects/" class="label">← All projects</a></p>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    <dl class="facts">
      <div><dt class="label">Status</dt><dd>{statusLabel(project)}</dd></div>
      <div><dt class="label">Year</dt><dd>{yearsOf(project)}</dd></div>
      {
        studio && (
          <div>
            <dt class="label">Studio</dt>
            <dd>{studio}</dd>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div>
            <dt class="label">Tags</dt>
            <dd class="tags">{tags.join(' · ')}</dd>
          </div>
        )
      }
      {
        links.length > 0 && (
          <div>
            <dt class="label">Links</dt>
            <dd class="links">
              {links.map((link) => (
                <a href={link.url}>{link.label} ↗</a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>
    <DecoMotif slot="art" seed={project.id} kind={art} class="art" />
  </Hero>

  <main id="main" class="page" style={`--texture:${texture}`}>
    <article class="wrap prose">
      {showCover && <Exhibit src={cover} alt={coverAlt} />}
      <Content components={{ img: Exhibit, YouTube, GoogleSlides }} />
    </article>

    {
      gallery.length > 0 && (
        <section class="wrap gallery-section" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading">Gallery</h2>
          <ul class="gallery">
            {gallery.map((item) => (
              <li>
                <Exhibit src={item.src} alt={item.alt} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="wrap">
      <DecoRule />
      <nav class="pager" aria-label="More projects">
        {
          newer ? (
            <a href={`/projects/${newer.id}/`} rel="prev" class="stepped">
              <span class="label">← Newer</span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a href={`/projects/${older.id}/`} rel="next" class="stepped older">
              <span class="label">Older →</span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .crumb {
    margin-bottom: 20px;
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold-light);
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    text-wrap: balance;
  }

  .summary {
    max-width: 560px;
    margin-top: 18px;
    color: var(--on-dark-muted);
    font-size: 1.125rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 0;
    margin: 32px 0 0;
  }

  .facts > div {
    padding: 2px 24px;
    border-left: 1px solid rgb(201 162 74 / 0.5);
  }

  .facts > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  dt {
    color: var(--gold);
  }

  dd {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .tags {
    text-transform: capitalize;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .links a {
    color: var(--gold-light);
  }

  :global(.hero .art) {
    flex: 0 0 auto;
    width: clamp(220px, 28vw, 350px); 
  }

  @media (max-width: 760px) {
    :global(.hero .art) {
      position: absolute;
      right: -40px;
      bottom: 0;
      width: 300px;
      opacity: 0.35;
    }
  }

  /* The lattice shows in the margins. The reading column sits on plain paper. */
  .page {
    padding-top: 56px;
    background:
      linear-gradient(90deg, transparent, var(--paper) 18%, var(--paper) 82%, transparent),
      var(--texture) var(--paper);
  }

  /* One centred reading column. Framed media may grow wider than the text. */
  .prose {
    display: grid;
    grid-template-columns:
      [wide-start] minmax(0, 1fr)
      [text-start] min(var(--prose-width), 100%)
      [text-end] minmax(0, 1fr)
      [wide-end];
    row-gap: 1.25em;
    padding-bottom: 56px;
    color: var(--ink-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose > :global(*) {
    grid-column: text;
  }

  .prose > :global(.frame) {
    grid-column: wide;
    justify-self: center;
    width: min(100%, 860px);
    margin-block: 1em;
  }

  .prose > :global(.frame.sized) {
    width: auto;
    max-width: 100%;
  }

  .prose :global(h2) {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 1em;
    color: var(--ink);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .prose :global(h2)::before {
    content: '';
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    background: var(--coral);
    transform: rotate(45deg);
  }

  .prose :global(h2)::after {
    content: '';
    flex: 1 1 auto;
    height: 5px;
    border-block: 1.5px solid var(--gold);
  }

  .prose :global(h3) {
    margin-top: 0.75em;
    color: var(--ink);
    font-size: 1.375rem;
  }

  .prose :global(a) {
    color: var(--teal);
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
    padding-left: 1.25em;
  }

  .prose :global(blockquote) {
    margin: 0.5em 0;
    padding: 20px 24px 20px 28px;
    border-left: 4px double var(--gold);
    background: var(--cream);
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .prose :global(blockquote > * + *) {
    margin-top: 0.75em;
  }

  /* A closing line in a quote, such as the speaker's name, reads as an attribution. */
  .prose :global(blockquote > p:last-child:not(:first-child)) {
    color: var(--coral);
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    text-transform: uppercase;
  }

  .prose :global(code) {
    padding: 2px 6px;
    background: var(--cream);
    font-size: 0.9em;
  }

  .gallery-section {
    padding-bottom: 56px;
  }

  .gallery-section h2 {
    margin-bottom: 24px;
    font-size: 2rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-block: 32px 64px;
  }

  .pager a {
    --step: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 20px 32px;
    background: var(--navy);
    color: var(--on-dark);
    text-decoration: none;
  }

  .pager a .label {
    color: var(--gold);
  }

  .pager a:hover {
    background: var(--teal);
  }

  .older {
    margin-left: auto;
    text-align: right;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
</style>
