---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YouTube from '../../components/YouTube.astro';
import GoogleSlides from '../../components/GoogleSlides.astro';
import { getProjects, statusLabel, yearsOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, newer: projects[i - 1], older: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  newer?: Project;
  older?: Project;
}

const { project, newer, older } = Astro.props;
const { Content } = await render(project);
const { title, summary, cover, coverAlt, gallery, links, tags } = project.data;
---

<Layout title={title} description={summary}>
  <Hero current="projects" compact>
    <p class="crumb"><a href="/projects/">← All work</a></p>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
  </Hero>

  <main id="main">
    <div class="wrap specimen">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1100px) 780px, 100vw"
        class="cover"
        loading="eager"
      />
      <dl class="facts">
        <div><dt>Status</dt><dd>{statusLabel(project)}</dd></div>
        <div><dt>Year</dt><dd>{yearsOf(project)}</dd></div>
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd class="tags">{tags.join(', ')}</dd>
            </div>
          )
        }
        {
          links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd>
                <ul class="links">
                  {links.map((link) => (
                    <li>
                      <a href={link.url}>{link.label} ↗</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <div class="wrap">
      <article class="prose">
        <Content components={{ YouTube, GoogleSlides }} />
      </article>
    </div>

    {
      gallery.length > 0 && (
        <section class="wrap gallery-section" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading">Gallery</h2>
          <ul class="gallery">
            {gallery.map((item) => (
              <li>
                <Image src={item.src} alt={item.alt} widths={[480, 960]} sizes="(min-width: 900px) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="wrap pager" aria-label="More projects">
      {
        newer ? (
          <a href={`/projects/${newer.id}/`} rel="prev">
            <span class="pager-label">← Newer</span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        older && (
          <a href={`/projects/${older.id}/`} rel="next" class="older">
            <span class="pager-label">Older →</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>

  <SiteFooter />
</Layout>

<style>
  .crumb {
    margin-bottom: 16px;
    font-weight: 600;
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.035em;
  }

  .summary {
    max-width: 640px;
    margin-top: 12px;
    color: var(--on-blue-muted);
    font-size: 1.125rem;
  }

  .specimen {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
    padding-block: 32px 0;
  }

  .cover {
    flex: 2 1 520px;
    min-width: 0;
    max-width: 960px;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .facts {
    flex: 1 1 240px;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: var(--yellow);
  }

  dt {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  dd {
    margin: 2px 0 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .tags {
    text-transform: capitalize;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding-block: 6px;
  }

  .prose {
    max-width: 760px;
    padding-block: 40px;
    color: var(--ink-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 1.75em;
    color: var(--ink);
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    margin-top: 1.5em;
    color: var(--ink);
    font-size: 1.5rem;
  }

  .prose :global(a) {
    color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .prose :global(img),
  .prose :global(youtube-embed),
  .prose :global(.slides) {
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--white);
    font-size: 0.9em;
  }

  .gallery-section {
    padding-bottom: 40px;
  }

  .gallery-section h2 {
    margin-bottom: 20px;
    font-size: 1.75rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 56px;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 20px 28px;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .pager a:hover {
    background: var(--ink);
    color: var(--white);
  }

  .older {
    margin-left: auto;
    text-align: right;
  }

  .pager-label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pager-title {
    font-size: 1.5rem;
    font-weight: 800;
  }
</style>
