---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DecoMotif from '../../components/DecoMotif.astro';
import { getProjects } from '../../lib/projects';
import { diamondLattice } from '../../lib/patterns';

const projects = await getProjects();
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const texture = diamondLattice('rgba(201,162,74,0.16)', 40);
---

<Layout title="Projects" description="Games, engines and tools I've built, newest first.">
  <Hero current="projects" compact>
    <h1>Projects</h1>
    <p class="intro">Games, engines and tools I've built, newest first.</p>
    <DecoMotif slot="art" seed="projects" kind="fan" class="art" />
  </Hero>

  <main id="main" style={`--texture:${texture}`}>
  <div class="wrap section">
    <div class="filters" role="group" aria-label="Filter by tag">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {
        tags.map((tag) => (
          <button type="button" data-filter={tag} aria-pressed="false">
            {tag}
          </button>
        ))
      }
    </div>
    <ul class="tiles">
      {
        projects.map((project, i) => (
          <li data-tags={project.data.tags.join(' ')}>
            <ProjectTile project={project} index={i} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </div>
  </main>

  <SiteFooter />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-tags]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.filter;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      for (const item of items) {
        item.hidden = tag !== 'all' && !item.dataset.tags?.split(' ').includes(tag ?? '');
      }
    });
  }
</script>

<style>
  h1 {
    font-size: clamp(2.75rem, 6vw, 4.75rem);
  }

  .intro {
    max-width: 560px;
    margin-top: 16px;
    color: var(--on-dark-muted);
    font-size: 1.125rem;
  }

  :global(.hero .art) {
    flex: 0 0 auto;
    width: clamp(220px, 28vw, 340px);
  }

  @media (max-width: 700px) {
    :global(.hero .art) {
      display: none;
    }
  }

  main {
    background:
      linear-gradient(90deg, transparent, var(--paper) 18%, var(--paper) 82%, transparent),
      var(--texture) var(--paper);
  }

  .section {
    padding-block: 40px 72px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  button {
    min-height: 44px;
    padding: 8px 18px;
    border: 1.5px solid var(--navy);
    background: transparent;
    color: var(--navy);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:hover {
    background: var(--cream);
  }

  button[aria-pressed='true'] {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--gold-light);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
