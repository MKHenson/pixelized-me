---
import { pick, seededRandom } from '../lib/seed';

interface Props {
  /** Seeds the composition. The same key always draws the same artwork. */
  seed: string;
  /** Forces one composition instead of the seeded choice. */
  kind?: Kind;
  /** Forces the accent colour instead of the seeded choice. */
  accent?: string;
  class?: string;
}

/** `halo` is a backdrop only: rays and rings round an empty centre, for the 3D hero. */
type Kind = 'sunrise' | 'fan' | 'ziggurat' | 'arches' | 'skull' | 'halo';

const { seed, class: className } = Astro.props;
const random = seededRandom(seed);
const kind: Kind = Astro.props.kind ?? pick(random, ['sunrise', 'fan', 'ziggurat', 'arches', 'skull'] as const);
const seededAccent = pick(random, ['var(--coral)', 'var(--teal-light)', 'var(--gold)'] as const);
const accent = Astro.props.accent ?? seededAccent;
const second = accent === 'var(--teal-light)' ? 'var(--coral)' : 'var(--teal-light)';

/**
 * The artwork is drawn on a grid of square cells, like a sprite. Each cell takes the colour
 * of the top layer that covers its centre. Rays fade out through ordered dithering.
 */
const W = 520;
const H = 360;
// Four units per cell matches the 3D hero, which renders one pixel per four screen pixels.
const CELL = 4;
const COLS = W / CELL;
const ROWS = H / CELL;

const gold = 'var(--gold)';
const navyLight = 'var(--navy-light)';
const navy = 'var(--navy)';

type Layer = { color: string; covers: (x: number, y: number, col: number, row: number) => boolean };
/** Top layer first. */
const layers: Layer[] = [];

const BAYER = [
  [0, 8, 2, 10],
  [12, 4, 14, 6],
  [3, 11, 1, 9],
  [15, 7, 13, 5],
];
const EDGE_FADE = 56;
const threshold = (col: number, row: number) => (BAYER[row % 4][col % 4] + 0.5) / 16;

const angleOf = (x: number, y: number, cx: number, cy: number) => {
  const a = Math.atan2(y - cy, x - cx);
  return a < 0 ? a + 2 * Math.PI : a;
};
const distance = (x: number, y: number, cx: number, cy: number) => Math.hypot(x - cx, y - cy);
const inArc = (a: number, from: number, to: number) => a >= from && a <= to;

/**
 * Alternate wedges between two angles. Solid near the centre, then dithered out by `reach`, and
 * also within `EDGE_FADE` of the artwork's border so no ray ends in a hard cut.
 */
function rays(cx: number, cy: number, from: number, to: number, count: number, reach: number, color: string, density: number) {
  const step = (to - from) / count;
  layers.push({
    color,
    covers: (x, y, col, row) => {
      const a = angleOf(x, y, cx, cy);
      if (!inArc(a, from, to) || Math.floor((a - from) / step) % 2 !== 0) return false;
      const radial = Math.min(1, (1 - distance(x, y, cx, cy) / reach) / 0.45);
      const edge = Math.min(x, W - x, y, H - y) / EDGE_FADE;
      return Math.min(radial, edge) * density > threshold(col, row);
    },
  });
}

/** A ring one cell thick between two angles. */
function ring(cx: number, cy: number, radius: number, from: number, to: number, color = gold) {
  layers.push({
    color,
    covers: (x, y) => Math.abs(distance(x, y, cx, cy) - radius) < CELL * 0.55 && inArc(angleOf(x, y, cx, cy), from, to),
  });
}

/** A filled shape with a one-cell outline, from a test that can shrink the shape by an inset. */
function outlined(inside: (x: number, y: number, inset: number) => boolean, fill: string, line = gold) {
  layers.push({ color: line, covers: (x, y) => inside(x, y, 0) && !inside(x, y, CELL) });
  layers.push({ color: fill, covers: (x, y) => inside(x, y, 0) });
}

const box = (left: number, top: number, right: number, bottom: number) => (x: number, y: number, inset: number) =>
  x >= left + inset && x <= right - inset && y >= top + inset && y <= bottom - inset;

/**
 * Stepped tiers, widest at the bottom, drawn as one shape. The outline follows the outer edge only,
 * so tiers that touch do not get a doubled line where they meet.
 */
function steps(cx: number, base: number, width: number, stepWidth: number, stepHeight: number, count: number, fill = navyLight) {
  const tiers = Array.from({ length: count }, (_, i) => {
    const half = width / 2 - i * stepWidth;
    const y = base - i * stepHeight;
    return box(cx - half, y - stepHeight, cx + half, y);
  });
  const inside = (x: number, y: number) => tiers.some((tier) => tier(x, y, 0));
  layers.push({
    color: gold,
    covers: (x, y) =>
      inside(x, y) && (!inside(x - CELL, y) || !inside(x + CELL, y) || !inside(x, y - CELL) || !inside(x, y + CELL)),
  });
  layers.push({ color: fill, covers: inside });
}

type Inside = (x: number, y: number) => boolean;

function inPolygon(points: number[][], x: number, y: number) {
  let hit = false;
  for (let i = 0, j = points.length - 1; i < points.length; j = i++) {
    const [xi, yi] = points[i];
    const [xj, yj] = points[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit;
  }
  return hit;
}

const inEllipse = (x: number, y: number, cx: number, cy: number, rx: number, ry: number) =>
  ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1;

function diamond(cx: number, cy: number, size: number, color = gold) {
  layers.push({ color, covers: (x, y) => Math.abs(x - cx) + Math.abs(y - cy) <= size });
}

if (kind === 'sunrise') {
  const cx = W / 2;
  const cy = H - 3 * 24;
  steps(cx, H, 520, 72, 24, 3);
  ring(cx, cy, 56, Math.PI, 2 * Math.PI, navy);
  layers.push({ color: accent, covers: (x, y) => distance(x, y, cx, cy) < 84 && y < cy });
  for (const radius of [124, 172, 220, 268]) ring(cx, cy, radius, Math.PI, 2 * Math.PI);
  rays(cx, cy, Math.PI, 2 * Math.PI, 16 + 2 * Math.floor(random() * 4), 300, `color-mix(in srgb, ${accent} 45%, var(--navy))`, 1);
}

if (kind === 'fan') {
  const right = random() > 0.5;
  const cx = right ? W : 0;
  const cy = H;
  const from = right ? Math.PI : 1.5 * Math.PI;
  const to = right ? 1.5 * Math.PI : 2 * Math.PI;
  layers.push({ color: second, covers: (x, y) => distance(x, y, cx, cy) < 64 });
  const ribs = 7;
  layers.push({
    color: gold,
    covers: (x, y) => {
      const d = distance(x, y, cx, cy);
      if (d > 336) return false;
      const a = angleOf(x, y, cx, cy);
      for (let i = 0; i <= ribs; i++) {
        const rib = from + ((to - from) * i) / ribs;
        if (Math.abs(a - rib) * d < CELL * 0.55) return true;
      }
      return false;
    },
  });
  for (const radius of [128, 196, 264]) ring(cx, cy, radius, from, to);
  layers.push({ color: gold, covers: (x, y) => Math.abs(distance(x, y, cx, cy) - 332) < CELL * 1.1 && inArc(angleOf(x, y, cx, cy), from, to) });
  rays(cx, cy, from, to, 14, 360, accent, 1);
}

if (kind === 'ziggurat') {
  const cx = W / 2;
  // Four tiers of seven cells: an outline row, then room for a three-cell diamond with a gap round it.
  const tier = 56;
  const apex = H - 4 * tier;
  for (let i = 0; i < 4; i++) diamond(cx, H - i * tier - tier / 2, 16);
  steps(cx, H, 440, 55, tier, 4);
  layers.push({ color: accent, covers: (x, y) => distance(x, y, cx, apex) < 48 && y < apex });
  rays(cx, apex, Math.PI, 2 * Math.PI, 22, 230, accent, 0.95);
}

if (kind === 'arches') {
  const cx = W / 2;
  // Arches and pillars stand on a one-step plinth, the same base the other artworks use.
  const floor = H - 20;
  diamond(cx, 32, 16);
  // One strict edge test for the curve and the sides, so the outline does not kink where they meet.
  const arch = (half: number, top: number) => (x: number, y: number, inset: number) => {
    const h = half - inset;
    const crown = top + half;
    if (y >= crown) return Math.abs(x - cx) < h && y <= floor;
    return distance(x, y, cx, crown) < h;
  };
  const widths = [64, 130, 200, 270, 340];
  const fills = [navy, accent, navy, second, navyLight];
  widths.forEach((width, i) => outlined(arch(width / 2, 60 + (4 - i) * 34), fills[i]));
  for (const x of [cx - 222, cx + 222]) {
    layers.push({ color: gold, covers: (px, py) => py >= 136 && py <= 148 && Math.abs(px - x) <= 24 });
    outlined((px, py, inset) => Math.abs(px - x) <= 16 - inset && py >= 148 + inset && py <= floor, navyLight);
  }
  steps(cx, H, 500, 0, 20, 1);
  // Rays from the arch's centre fan out behind it, so the doorway reads as lit from within.
  rays(cx, 230, Math.PI, 2 * Math.PI, 20, 460, `color-mix(in srgb, ${second} 45%, var(--navy))`, 1);
}

if (kind === 'skull') {
  // A T-rex skull in side view, facing left, on a stepped podium. The outline is drawn in local
  // units, 226 wide and 132 tall, then scaled by SCALE and set on top of the podium.
  // T-rex proportions: a blunt, deep snout, a heavy jaw, D-shaped openings behind a small eye.
  const SCALE = 1.3;
  const podiumTop = H - 96;
  const ox = W / 2 - (226 * SCALE) / 2;
  const oy = podiumTop - 130 * SCALE;
  const cranium = [
    [0, 44], [6, 36], [24, 32], [34, 28], [52, 27], [80, 21], [120, 13], [150, 5], [178, 1], [202, 7], [218, 20],
    [226, 40], [224, 64], [214, 86], [204, 98], [186, 88], [160, 82], [120, 80], [80, 78], [40, 76], [10, 74], [2, 62],
  ];
  const jaw = [
    [12, 90], [60, 92], [120, 96], [170, 100], [202, 106], [212, 118], [196, 132], [150, 130], [100, 122], [50, 112],
    [16, 102], [8, 96],
  ];
  const antorbital = [[58, 40], [104, 30], [128, 38], [122, 60], [84, 66], [60, 56]];
  const temporal = [[166, 24], [198, 18], [212, 38], [204, 70], [178, 64], [168, 44]];
  const hole = (x: number, y: number) =>
    inEllipse(x, y, 14, 50, 7, 5) ||
    inPolygon(antorbital, x, y) ||
    inEllipse(x, y, 147, 32, 7, 11) ||
    inPolygon(temporal, x, y) ||
    inEllipse(x, y, 166, 116, 16, 6);
  const bone: Inside = (x, y) => {
    const lx = (x - ox) / SCALE;
    const ly = (y - oy) / SCALE;
    return (inPolygon(cranium, lx, ly) || inPolygon(jaw, lx, ly)) && !hole(lx, ly);
  };

  const cx = W / 2;
  for (const dx of [-60, 0, 60]) diamond(cx + dx, podiumTop + 16, 10);
  steps(cx, H, 340, 40, 32, 3);

  // Bone shades from cream at the crown to tan along the jaw, through a dithered band.
  const tan = 'color-mix(in srgb, var(--gold) 45%, var(--cream))';
  layers.push({
    color: gold,
    covers: (x, y) => bone(x, y) && (!bone(x - CELL, y) || !bone(x + CELL, y) || !bone(x, y - CELL) || !bone(x, y + CELL)),
  });
  layers.push({
    color: 'var(--cream)',
    covers: (x, y, col, row) => bone(x, y) && Math.min(1, Math.max(0, (oy + 78 * SCALE - y) / (34 * SCALE))) > threshold(col, row),
  });
  layers.push({ color: tan, covers: bone });

  // Teeth hang from the upper jaw and rise from the lower one, across the open mouth.
  const tooth = (tipX: number, tipY: number, rootY: number, half: number) => (x: number, y: number) => {
    const t = (y - rootY) / (tipY - rootY);
    return t >= 0 && t <= 1 && Math.abs(x - tipX) <= half * (1 - t);
  };
  const teeth: Inside[] = [];
  const at = (x: number, y: number) => [ox + x * SCALE, oy + y * SCALE];
  for (let x = 18; x <= 170; x += 16) {
    const [tx, tip] = at(x, 92 - x / 40);
    teeth.push(tooth(tx, tip, at(x, 74 - x / 40)[1], 6 * SCALE));
  }
  for (let x = 28; x <= 160; x += 20) {
    const [tx, tip] = at(x, 80 + x / 30);
    teeth.push(tooth(tx, tip, at(x, 94 + x / 30)[1], 4.5 * SCALE));
  }
  layers.push({ color: 'var(--paper)', covers: (x, y) => teeth.some((inTooth) => inTooth(x, y)) });

  rays(cx, oy + 50 * SCALE, 0, 2 * Math.PI, 24, 300, `color-mix(in srgb, ${accent} 40%, var(--navy))`, 1);
}

if (kind === 'halo') {
  const cx = W / 2;
  const cy = 112;
  for (const radius of [76, 116]) ring(cx, cy, radius, 0, 2 * Math.PI);
  rays(cx, cy, 0, 2 * Math.PI, 28, 300, `color-mix(in srgb, ${accent} 40%, var(--navy))`, 1);
}

// Paint the grid, then merge each row into runs of one colour.
const runs: { x: number; y: number; w: number; color: string }[] = [];
for (let row = 0; row < ROWS; row++) {
  let current: (typeof runs)[number] | undefined;
  for (let col = 0; col < COLS; col++) {
    const x = col * CELL + CELL / 2;
    const y = row * CELL + CELL / 2;
    const color = layers.find((layer) => layer.covers(x, y, col, row))?.color;
    if (color && current?.color === color && current.x + current.w === col * CELL) {
      current.w += CELL;
    } else if (color) {
      current = { x: col * CELL, y: row * CELL, w: CELL, color };
      runs.push(current);
    } else {
      current = undefined;
    }
  }
}
---

<svg
  class:list={['motif', className]}
  viewBox={`0 0 ${W} ${H}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  data-kind={kind}
>
  {runs.map((run) => <rect x={run.x} y={run.y} width={run.w} height={CELL} style={`fill:${run.color}`} />)}
</svg>

<style>
  .motif {
    width: 100%;
    height: auto;
  }
</style>
