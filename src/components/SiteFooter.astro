---
import { chevronBand } from '../lib/patterns';
import DecoMotif from './DecoMotif.astro';

const year = new Date().getFullYear();
const band = chevronBand('#c9a24a');
---

<footer id="contact" class="footer" style={`--band:${band}`}>
  <div class="band" aria-hidden="true"></div>
  <div class="wrap content">
    <div class="text">
      <h2>Let's make<br />something.</h2>
      <ul>
        <li><a class="pill pill-solid" href="#contact">[email]</a></li>
        <li><a class="pill" href="https://github.com/MKHenson">GitHub</a></li>
        <li><a class="pill" href="#contact">[LinkedIn]</a></li>
      </ul>
      <p class="copyright label">© {year} Mathew Henson</p>
    </div>
    <DecoMotif seed="footer" kind="sunrise" class="art" />
  </div>
</footer>

<style>
  .footer {
    overflow: hidden;
    background: var(--navy);
    color: var(--on-dark);
  }

  .band {
    height: 14px;
    background-image: var(--band);
    background-repeat: repeat-x;
    border-bottom: 2px solid var(--gold);
    box-shadow: 0 -4px 0 0 var(--navy), 0 -6px 0 0 var(--gold);
    margin-top: 6px;
  }

  .content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }

  .text {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 64px 40px;
  }

  h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill:not(.pill-solid) {
    border-color: var(--gold);
    color: var(--gold-light);
  }

  .pill:not(.pill-solid):hover {
    background: var(--gold);
    color: var(--navy);
  }

  .pill-solid:hover {
    background: var(--gold-light);
  }

  .copyright {
    color: var(--on-dark-muted);
  }

  .art {
    flex: 0 1 auto;
    width: clamp(220px, 30vw, 360px);
  }

  @media (max-width: 700px) {
    .art {
      display: none;
    }
  }
</style>
