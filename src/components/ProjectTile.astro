---
import { Image } from 'astro:assets';
import { statusLabel, yearsOf, type Project } from '../lib/projects';

export const tones = ['blue', 'orange', 'yellow', 'white', 'pink'] as const;

interface Props {
  project: Project;
  index: number;
  headingLevel?: 'h2' | 'h3';
  /** `feature` is the larger bento tile; `card` is the compact grid card. */
  variant?: 'feature' | 'card';
  /** Feature tiles only: lays the image beside the text instead of above it. */
  wide?: boolean;
}

const { project, index, headingLevel: Heading = 'h3', variant = 'card', wide = false } = Astro.props;
const { title, summary, cover, coverAlt } = project.data;
const tone = tones[index % tones.length];

const sizes = {
  card: '(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw',
  feature: '(min-width: 1440px) 460px, (min-width: 800px) 33vw, 100vw',
  wide: '(min-width: 1440px) 840px, (min-width: 800px) 60vw, 100vw',
};
const imageSizes = variant === 'card' ? sizes.card : wide ? sizes.wide : sizes.feature;
---

<article class:list={['tile', `tone-${tone}`, variant, { wide }]}>
  <div class="media">
    <Image src={cover} alt={coverAlt} widths={[480, 800, 1200, 1680]} sizes={imageSizes} class="cover" />
  </div>
  <div class="body">
    <span class="tag">{statusLabel(project)}</span>
    <Heading class="title">
      <a href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <p class="year">{yearsOf(project)}</p>
  </div>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 10px;
    border-radius: var(--radius);
    color: var(--ink);
    transition: transform 150ms ease;
  }

  .tile:has(a:hover) {
    transform: translateY(-4px);
  }

  .tone-blue {
    background: var(--blue);
    color: var(--white);
  }

  .tone-orange {
    background: var(--orange);
  }

  .tone-yellow {
    background: var(--yellow);
  }

  .tone-white {
    background: var(--white);
    border: 2px solid var(--ink);
  }

  .tone-pink {
    background: var(--pink);
  }

  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius) - 6px);
    background: rgb(0 0 0 / 0.15);
  }

  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    padding: 0 10px 10px;
  }

  .tag {
    background: var(--ink);
    color: var(--white);
  }

  .tone-blue .tag {
    background: var(--white);
    color: var(--blue);
  }

  .title {
    font-size: 1.5rem;
  }

  .title a {
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .tone-blue .summary {
    color: var(--on-blue-muted);
  }

  .year {
    margin-top: auto;
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .feature {
    padding: 12px;
  }

  .feature .body {
    padding: 4px 16px 16px;
  }

  .feature .title {
    margin-top: auto;
    padding-top: 12px;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
  }

  .feature .summary {
    max-width: 52ch;
    font-size: 1rem;
  }

  .feature .year {
    margin-top: 4px;
  }

  @media (min-width: 800px) {
    .feature.wide {
      flex-direction: row-reverse;
      min-height: 300px;
    }

    .feature.wide .media {
      flex: 1.5 1 0;
      aspect-ratio: auto;
    }

    .feature.wide .body {
      flex: 1 1 0;
      padding: 16px 12px 16px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }
</style>
