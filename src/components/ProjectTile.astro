---
import { Image } from 'astro:assets';
import { statusLabel, yearsOf, type Project } from '../lib/projects';

export const tones = ['navy', 'teal', 'cream'] as const;

interface Props {
  project: Project;
  index: number;
  headingLevel?: 'h2' | 'h3';
}

const { project, index, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, cover, coverAlt } = project.data;
const tone = tones[index % tones.length];
---

<article class:list={['tile', 'stepped', `tone-${tone}`]}>
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800]}
      sizes="(min-width: 1184px) 360px, (min-width: 700px) 50vw, 100vw"
      class="cover"
    />
  </div>
  <div class="body">
    <p class="label meta">{statusLabel(project)} · {yearsOf(project)}</p>
    <Heading class="title">
      <a href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .tile {
    --step: 8px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 150ms ease;
  }

  .tile:has(a:hover) {
    transform: translateY(-4px);
  }

  .tone-navy {
    background: var(--navy);
    color: var(--on-dark);
  }

  .tone-teal {
    background: var(--teal);
    color: var(--on-dark);
  }

  .tone-cream {
    background: var(--cream);
    color: var(--ink);
  }

  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 3px double var(--gold);
    background: rgb(0 0 0 / 0.2);
  }

  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
    padding: 20px 24px 28px;
  }

  .meta {
    color: var(--gold);
  }

  .tone-cream .meta {
    color: var(--coral);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    text-wrap: balance;
  }

  .title a {
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .tone-cream .summary {
    color: var(--ink-muted);
  }
</style>
