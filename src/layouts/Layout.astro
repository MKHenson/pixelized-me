---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Code, polygons and playable worlds.' } = Astro.props;
const pageTitle = title === 'pixelized.me' ? title : `${title} · pixelized.me`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-pixel" preload />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
